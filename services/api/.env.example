# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=sqlite:///./khazain_dev.db
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_FORCE_PASSWORD_CHANGE=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
MEDIA_ROOT=./var/media
MAX_UPLOAD_BYTES=15728640
PUBLIC_API_CACHE_SECONDS=300
PDF_TEXT_EXTRACTION_ENABLED=true

# Optional AI chat provider. Keep the key on the API server only; never put it in Flutter.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
